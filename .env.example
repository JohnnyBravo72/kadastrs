# Optional overrides for the local dev stack (docs/runbook.md).
# Copy to .env (git-ignored) only if you need to change something; without a
# .env, infra/docker-compose.yml uses exactly these defaults.
#
# DEV-ONLY VALUES. The stack is local only (D3 interim): ports bind to 127.0.0.1.
# Never reuse these for shared hosting (Phase 10 sets real secrets).

KADASTRS_DB_PASSWORD=kadastrs-dev
KADASTRS_DB_PORT=5432
KADASTRS_API_PORT=8000
