# Text files: always LF (default for anything git detects as text,
# incl. Dockerfile, shell scripts and .toml; containers need LF)
* text=auto eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.sh   text eol=lf
.gitattributes text eol=lf

# Binary files: no diff, no line-ending conversion
*.xlsx binary
*.png  binary
*.shp  binary
*.dbf  binary
*.gpkg binary
*.tif  binary
